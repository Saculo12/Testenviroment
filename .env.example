# Get a free FRED API key at https://fredaccount.stlouisfed.org/apikeys
FRED_API_KEY=your_fred_api_key_here

# Optional: override the Zillow ZORI Metro CSV URL if Zillow changes the path.
# Browse the source list at https://www.zillow.com/research/data/
# ZORI_METRO_CSV_URL=https://files.zillowstatic.com/research/public_csvs/zori/Metro_zori_uc_sfrcondomfr_sm_month.csv

# ---------------------------------------------------------------------------
# Broker email ingester (broker_ingester.py)
# ---------------------------------------------------------------------------
# Gmail: turn on 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords  (Gmail dropped basic-auth in 2022)
# Use the 16-char App Password below, NOT your normal Gmail password.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=deals@yourdomain.com
IMAP_PASSWORD=your_app_password_here
# Optional: which folder/label to read (default INBOX)
# IMAP_FOLDER=INBOX
# Optional: override the broker domain whitelist (comma-separated, no spaces).
# BROKER_DOMAINS=cbre.com,jll.com,ipausa.com,abimf.com,crexi.com
